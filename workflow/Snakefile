# workflow/Snakefile
configfile: "config/config.yaml"

import os, glob, json

# ----------------------------
# Parse JSON/YAML blobs passed via --config
# ----------------------------
def _autoparse(value):
    if isinstance(value, str):
        s = value.strip()
        if (s.startswith("{") and s.endswith("}")) or (s.startswith("[") and s.endswith("]")):
            try:
                return json.loads(s)
            except Exception:
                try:
                    import yaml
                    return yaml.safe_load(s)
                except Exception:
                    return value
    return value

for k in ("assembler", "modkit", "aggregation", "toggles", "mods", "ref_bases", "test_diffs", "classify_diffs", "multigene_filter", "report", "genotype"):
    if k in config:
        config[k] = _autoparse(config[k])

# ----------------------------
# References (flattened or nested)
# ----------------------------
REF_FA  = config.get("reference_fa",  config.get("reference", {}).get("fasta"))
REF_GTF = config.get("reference_gtf", config.get("reference", {}).get("gtf"))
MODKIT_CFG = config.get("modkit", {})

# ----------------------------
# Shared helpers
# ----------------------------
def _is_set(v):
    if v is None:
        return False
    if isinstance(v, str) and v.strip().lower() in {"", "none", "null", "na"}:
        return False
    return True

def _as_bool(v, default=False):
    if v is None:
        return default
    if isinstance(v, bool):
        return v
    if isinstance(v, (int, float)):
        return v != 0
    if isinstance(v, str):
        s = v.strip().lower()
        if s in {"1","true","yes","y","on"}:  return True
        if s in {"0","false","no","n","off"}: return False
        if s in {"","none","null","na"}:      return default
    return bool(v)

def _as_flags_from_common(common, sample, which):
    """Build modkit flags from 'modkit.common' config."""
    flags = []

    # Logging
    log_tmpl = common.get("log_file_template")
    if _is_set(log_tmpl):
        flags += ["--log-filepath", log_tmpl.format(sample=sample, which=which)]

    # Selection
    if _is_set(common.get("region")):             flags += ["--region", str(common["region"])]
    if common.get("max_depth") is not None:       flags += ["--max-depth", str(common["max_depth"])]
    if _is_set(common.get("include_bed")):        flags += ["--include-bed", str(common["include_bed"])]
    if _as_bool(common.get("include_unmapped")):  flags += ["--include-unmapped"]
    if _is_set(common.get("edge_filter")):        flags += ["--edge-filter", str(common["edge_filter"])]
    if _as_bool(common.get("invert_edge_filter")):flags += ["--invert-edge-filter"]

    # Compute
    threads_val = str(common.get("threads", "{threads}")).replace("{threads}", str(config.get("threads", 4)))
    if _is_set(threads_val):                      flags += ["-t", threads_val]
    if _is_set(common.get("interval_size")):      flags += ["--interval-size", str(common["interval_size"])]
    if _is_set(common.get("queue_size")):         flags += ["--queue-size", str(common["queue_size"])]
    if _is_set(common.get("chunk_size")):         flags += ["--chunk-size", str(common["chunk_size"])]

    # Sampling
    if _is_set(common.get("num_reads")):          flags += ["--num-reads", str(common["num_reads"])]
    if _is_set(common.get("sampling_frac")):      flags += ["--sampling-frac", str(common["sampling_frac"])]
    seed_val = common.get("seed")
    if not (isinstance(seed_val, str) and seed_val.strip().lower() in {"none","null",""}):
        if seed_val is not None:
            flags += ["--seed", str(seed_val)]
    if _is_set(common.get("sample_region")):      flags += ["--sample-region", str(common["sample_region"])]
    if _is_set(common.get("sampling_interval_size")):
        flags += ["--sampling-interval-size", str(common["sampling_interval_size"])]

    # Filtering
    if _as_bool(common.get("no_filtering")):      flags += ["--no-filtering"]
    if common.get("filter_percentile") is not None:
        flags += ["--filter-percentile", str(common["filter_percentile"])]
    for ft in (common.get("filter_thresholds") or []):
        if _is_set(ft):
            flags += ["--filter-threshold", str(ft)]
    for mt in (common.get("mod_thresholds") or []):
        if _is_set(mt) and ":" in str(mt):
            flags += ["--mod-threshold", str(mt)]

    # Modified base options
    for ign in (common.get("ignore") or []):
        if _is_set(ign):
            flags += ["--ignore", str(ign)]
    if _as_bool(common.get("force_allow_implicit")): flags += ["--force-allow-implicit"]
    for m in (common.get("motif") or []):
        if _is_set(m) and ":" in str(m):
            motif, off = str(m).split(":", 1)
            flags += ["--motif", motif, str(off)]
    if _as_bool(common.get("cpg")):               flags += ["--cpg"]
    if _as_bool(common.get("ref_mask")):          flags += ["--mask"]
    if _as_bool(common.get("combine_mods")):      flags += ["--combine-mods"]
    if _as_bool(common.get("combine_strands")):   flags += ["--combine-strands"]

    # Output
    if _as_bool(common.get("only_tabs")):         flags += ["--only-tabs"]
    if _as_bool(common.get("mixed_delim")):       flags += ["--mixed-delim"]
    if _as_bool(common.get("bedgraph")):          flags += ["--bedgraph"]
    if _as_bool(common.get("header")):            flags += ["--header"]
    if _is_set(common.get("prefix")):             flags += ["--prefix", str(common["prefix"])]
    if _as_bool(common.get("suppress_progress", True)):
        flags += ["--suppress-progress"]

    return flags

# ----------------------------
# Sample discovery
# ----------------------------
BAMS_DIR = config.get("bams_dir", "resources/test_bams/ALCAM_NHSL1_SERAC1_MXD1_RIOK3_reads")
BAM_GLOB = config.get("bam_glob", "*.bam")

def _discover_samples():
    paths = glob.glob(os.path.join(BAMS_DIR, BAM_GLOB))
    return sorted({os.path.splitext(os.path.basename(p))[0] for p in paths})

SAMPLES = _discover_samples()

# Expose for included rules
BAMS_DIR = BAMS_DIR
BAM_GLOB = BAM_GLOB
SAMPLES  = SAMPLES
REF_FA   = REF_FA
REF_GTF  = REF_GTF
MODKIT_CFG = MODKIT_CFG
_as_flags_from_common = _as_flags_from_common
_is_set = _is_set
_as_bool = _as_bool

