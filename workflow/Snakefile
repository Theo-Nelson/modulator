ENABLE_AGG_ZT     = _as_bool(config.get("toggles", {}).get("enable_zt_aggregate", True))
ENABLE_TEST_DIFFS = _as_bool(config.get("toggles", {}).get("enable_test_diffs", True))
ENABLE_CLASSIFY_DIFFS = _as_bool(config.get("classify_diffs", {}).get("enable", True))
ENABLE_MULTIGENE_FILTER = _as_bool(config.get("multigene_filter", {}).get("enable", True))
